# ==============================================================================
# Rocket Server Configuration
# ==============================================================================
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8000
# 256-bit base64 secret key for Rocket private cookies
ROCKET_SECRET_KEY=bWFrZXN1cmV0aGlzaXNhdmVyeXNlY3VyZTMyYnl0ZWtleWJhc2U2NA==

# ==============================================================================
# SurrealDB Persistence Configuration
# ==============================================================================
SURREALDB_URL=ws://127.0.0.1:8000
SURREALDB_NS=app_ns
SURREALDB_DB=app_db
SURREALDB_USER=root
SURREALDB_PASS=root

# ==============================================================================
# Google OpenID Connect (OAuth 2.0 Client Credentials)
# Obtain these from: Google Cloud Console > APIs & Services > Credentials
# Application Type: Web application
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Must match an Authorized redirect URI configured in Google Cloud Console
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# ==============================================================================
# Application Session Security
# ==============================================================================
# Secret used for signing internal session tokens / state validation
SESSION_SECRET=a_very_long_and_secure_random_string_for_sessions_here
SESSION_COOKIE_NAME=sid
SESSION_MAX_AGE_SECONDS=604800